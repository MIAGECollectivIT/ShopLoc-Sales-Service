meta {
  name: 07 - Rejet mise a jour statut sur commande inexistante - 404
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/v1/sales/orders/CMD-CC-INEXISTANTE-9999/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{merchantToken}}
}

body:json {
  {
    "status": "PAID"
  }
}

assert {
  res.status: eq 404
  res.body.message: isDefined
}

