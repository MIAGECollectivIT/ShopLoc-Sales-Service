meta {
  name: 08 - Rejet mise a jour statut par un role CLIENT - 403
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/v1/sales/orders/{{orderReference}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{clientToken}}
}

body:json {
  {
    "status": "PAID"
  }
}

assert {
  res.status: eq 403
  res.body.message: eq "Access denied: only merchants and administrators can update order status"
}
