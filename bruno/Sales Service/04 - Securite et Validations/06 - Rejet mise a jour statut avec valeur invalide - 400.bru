meta {
  name: 06 - Rejet mise a jour statut avec valeur invalide - 400
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/v1/sales/orders/{{orderReference}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{merchantToken}}
}

body:json {
  {
    "status": "STATUT_INVALIDE"
  }
}

assert {
  res.status: eq 400
  res.body.message: isDefined
}

