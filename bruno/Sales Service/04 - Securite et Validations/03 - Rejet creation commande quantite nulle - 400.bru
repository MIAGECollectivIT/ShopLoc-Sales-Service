meta {
  name: 03 - Rejet creation commande quantite nulle - 400
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/sales/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "items": [
      {
        "storeId": 1,
        "productId": 2,
        "productName": "Baguette",
        "unitPrice": 1.50,
        "quantity": 0
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.error: eq "Validation Failed"
}
