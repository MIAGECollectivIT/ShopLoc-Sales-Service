meta {
  name: 05 - Rejet creation commande sans productId - 400
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/sales/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{clientToken}}
}

body:json {
  {
    "items": [
      {
        "storeId": 1,
        "productName": "Baguette",
        "unitPrice": 1.50,
        "quantity": 1
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.error: eq "Validation Failed"
}

