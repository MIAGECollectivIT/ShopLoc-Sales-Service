meta {
  name: 03 - Consulter une commande par reference - 200
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/sales/orders/{{orderReference}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.orderReference: eq {{orderReference}}
  res.body.status: isDefined
  res.body.totalAmount: isDefined
  res.body.storeSummaries: isDefined
  res.body.items: isDefined
}
