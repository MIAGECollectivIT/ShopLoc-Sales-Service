# ==============================================================================
# Variables d'environnement - ShopLoc Sales Service
# ==============================================================================
# Ce fichier sert de modèle pour la configuration locale.
# Pour l'utiliser, dupliquez-le sous le nom .env :
#   cp .env.example .env
#
# NOTE :
# - En local (Docker Compose), les variables ci-dessous permettent de surcharger
#   les valeurs par défaut.
# - En production / cluster K3s, les secrets sont injectés directement
#   depuis les Secrets Kubernetes 'db-credentials-sales' et 'jwt-secret'.
# ==============================================================================

# Port d'écoute du service Spring Boot
PORT=8080

# Hôte et port de la base de données PostgreSQL
DB_HOST=db
DB_PORT=5432

# Identifiants de la base de données PostgreSQL
POSTGRES_DB=app_db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword

# ==============================================================================
# SÉCURITÉ JWT (Vérification par Clé Publique Asymétrique RSA RS256)
# ==============================================================================
# Clé publique RSA 2048-bit (X.509 Base64) - Fournie par Users-Service
# Seul Users-Service détient la clé privée pour signer les jetons.
JWT_PUBLIC_KEY=


# URL de Users-Service pour récupérer la clé publique / révocations au démarrage
USERS_SERVICE_URL=http://localhost:8080
